# StockVero API environment. Every variable is explained in ENVIRONMENT.md.
# With NODE_ENV=production the server refuses to start while a required one is missing.

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" on the deployed server: it also switches off the /api/v1/dev routes.
NODE_ENV="production"
PORT=4000

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct (non-pooled) connection, used only by Prisma migrations. Falls back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional. Database connections kept open (default 10).
DB_POOL_MAX=10

# ── Sign-in tokens (required) ────────────────────────────────────────────────
JWT_SECRET="a-long-random-string"
JWT_EXPIRES_IN="24h"
ADMIN_JWT_SECRET="another-long-random-string"
ADMIN_JWT_EXPIRES_IN="8h"
# Unlocks encrypted offline data on devices. Falls back to JWT_SECRET. Never change it once
# in use: sales still queued on phones become unreadable. To set it on an existing server,
# give it the same value JWT_SECRET has today.
DEVICE_KEY_SECRET="a-third-long-random-string"

# ── File storage (required) ──────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY="your-supabase-service-role-key"
# Public bucket: product images, documents, avatars, logos.
SUPABASE_STORAGE_BUCKET="solarflow-files"
# Private bucket (Public = OFF): signup identity documents.
SUPABASE_PRIVATE_BUCKET="stockvero-private"

# ── Addresses (required) ─────────────────────────────────────────────────────
# Sites allowed to call this API, comma-separated: the customer app and the admin console.
CORS_ORIGINS="https://stockvero.com,https://admin.stockvero.com"
# The customer app's address, used for the links in emails.
FRONTEND_URL=https://stockvero.com

# ── Email (required: Resend, or SMTP) ────────────────────────────────────────
# Resend is tried first; SMTP is used when Resend is not set or fails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="StockVero <no-reply@stockvero.com>"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="StockVero <your-email@gmail.com>"
