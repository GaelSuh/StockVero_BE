DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
JWT_SECRET="CHANGE_ME_generate_a_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="24h"
ADMIN_JWT_SECRET="CHANGE_ME_generate_a_separate_admin_secret_min_32_chars"
ADMIN_JWT_EXPIRES_IN="8h"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_STORAGE_BUCKET="solarflow-files"
PORT=4000
NODE_ENV="development"
DB_POOL_MAX=10
CORS_ORIGINS="http://localhost:5173,http://localhost:5175,http://localhost:8080"

# SMTP (Nodemailer - temporary development setup)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="StockVero <noreply@yourdomain.com>"

# RESEND (recommended for production)
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM="StockVero <noreply@yourdomain.com>"

