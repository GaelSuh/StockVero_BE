model CategoryStockLog {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  categoryId   String            @map("category_id")
  unitSystemId String?           @map("unit_system_id")
  eventType    String            @map("event_type")
  stockBefore  Int               @map("stock_before")
  stockAfter   Int               @map("stock_after")
  delta        Int
  title        String
  notes        String?
  performedBy  String?           @map("performed_by")
  /// Id the device generated when the stock movement was recorded offline. Makes
  /// a replayed sync idempotent — the same delivery cannot be received twice.
  offlineId    String?           @map("offline_id")
  /// Which variant this add/remove event applied to. Null for products with
  /// no variants. So the stock-detail page can show units-added-and-removed
  /// history accurately per variant instead of aggregated across every
  /// variant of a product.
  variantId    String?           @map("variant_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  category     InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant      ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Partial, matching the live index `category_stock_logs_tenant_id_offline_id_key`.
  /// The filter is what makes replay idempotency work: rows recorded online
  /// have no offlineId, and many NULLs must coexist freely.
  @@unique([tenantId, offlineId], where: raw("offline_id IS NOT NULL"))
  @@index([tenantId, categoryId])
  @@index([tenantId, categoryId, variantId])
  @@map("category_stock_logs")
}

