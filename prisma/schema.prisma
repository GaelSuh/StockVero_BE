generator client {
  provider        = "prisma-client-js"
  /// `partialIndexes` lets this schema declare filtered unique indexes
  /// (`@@unique([...], where: raw("..."))`). Three already existed in the
  /// database, added by hand-written migration SQL, and this schema could not
  /// describe them — so `schema.prisma` disagreed with the real database.
  ///
  /// Important: while this flag is ON, Prisma *sees* partial indexes, so any
  /// partial index that is not declared here will be DROPPED by the next
  /// migration. All three are declared (search this file for `where: raw`).
  /// Do not remove one of those declarations without also dropping the index
  /// deliberately. Turning this flag back off makes Prisma blind to them
  /// again, which is inert but restores the original schema-vs-database lie.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                         String                      @id @default(uuid())
  name                       String
  subdomain                  String                      @unique
  industry                   String?
  website                    String?
  logoUrl                    String?                     @map("logo_url")
  phone                      String?
  country                    String?
  city                       String?
  state                      String?

  /// Optional business-identity evidence supplied at signup, for the admin who
  /// approves the account. Optional by product decision — signup is never
  /// blocked on it.
  ///
  /// The document itself is PII (a tax certificate or a government ID card), so
  /// only its object path is stored, in the PRIVATE storage bucket. Nothing here
  /// is a public URL: admins read it through a short-lived signed URL, unlike
  /// the public-bucket URLs the older Document model keeps.
  verificationIdType   TenantVerificationIdType? @map("verification_id_type")
  /// Present for TAX_ID; a national ID card is identified by the image alone.
  verificationIdNumber String?                   @map("verification_id_number")
  /// Object path inside the private bucket, never a URL.
  verificationDocPath  String?                   @map("verification_doc_path")
  verificationDocName  String?                   @map("verification_doc_name")
  verificationDocMime  String?                   @map("verification_doc_mime")
  subscriptionPlan           SubscriptionPlan            @default(STARTER) @map("subscription_plan")
  status                     TenantStatus                @default(PENDING_APPROVAL)
  suspendedReason            String?                     @map("suspended_reason")
  notes                      String?
  approvedAt                 DateTime?                   @map("approved_at")
  approvedBy                 String?                     @map("approved_by")
  organisationSize           Int?                        @map("organisation_size")
  billingCycle               BillingCycle                @default(MONTHLY) @map("billing_cycle")
  trialEndsAt                DateTime?                   @map("trial_ends_at")
  isTrialActive              Boolean                     @default(false) @map("is_trial_active")
  nextBillingDate            DateTime?                   @map("next_billing_date")
  currentMonthlyAmount       Decimal?                    @map("current_monthly_amount") @db.Decimal(15, 2)
  currentAnnualAmount        Decimal?                    @map("current_annual_amount") @db.Decimal(15, 2)
  organizationType           OrganizationType?           @map("organization_type")
  themeConfig                Json?                       @map("theme_config")
  /// Tenant-level behaviour switches. Known keys:
  ///   stockApprovalRequired: boolean — finance must approve a purchase invoice
  ///   before serialised units can be added. Absent means true (legacy behaviour).
  settingsConfig             Json?                       @map("settings_config")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  activityLogs               AuditLog[]
  categoryStockLogs          CategoryStockLog[]
  customerContacts           CustomerContact[]
  customerPurchases          CustomerPurchase[]
  customers                  Customer[]
  documents                  Document[]
  employees                  Employee[]
  inventoryCategories        InventoryCategory[]
  inventoryItems             InventoryItem[]
  inventoryMovements         InventoryMovement[]
  invoicePayments            InvoicePayment[]
  invoiceSequence            InvoiceSequence?
  invoices                   Invoice[]
  notifications              Notification[]
  paymentMethods             PaymentMethod[]
  paymentTransactions        PaymentTransaction[]
  productCategories          ProductCategory[]
  productItemMaintenanceLogs ProductItemMaintenanceLog[]
  productItems               ProductItem[]
  productVariants            ProductVariant[]
  projectAssignments         ProjectAssignment[]
  projectMaterials           ProjectMaterial[]
  projectMilestones          ProjectMilestone[]
  projects                   Project[]
  roles                      Role[]
  stockMovements             StockMovement[]
  subscriptionModules        SubscriptionModule[]
  subscription               Subscription?
  auditLogs                  TenantAuditLog[]
  financeBalance             TenantFinanceBalance?
  modules                    TenantModule[]
  approvedByAdmin            SuperAdmin?                 @relation("TenantApprovedBy", fields: [approvedBy], references: [id])
  transactions               Transaction[]
  userPreferences            UserPreference[]
  users                      User[]
  sales                      Sale[]
  saleReturns                SaleReturn[]
  priceLists                 PriceList[]
  deliveryNotes              DeliveryNote[]
  dailySummaries             DailySummary[]
  saleSequence               SaleSequence?

  @@map("tenants")
}

model User {
  id                      String    @id @default(uuid())
  tenantId                String    @map("tenant_id")
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  role                    UserRole  @default(CLIENT_USER)
  avatarUrl               String?   @map("avatar_url")
  phone                   String?
  isActive                Boolean   @default(true) @map("is_active")
  tokenVersion            Int       @default(0) @map("token_version")
  lastLoginAt             DateTime? @map("last_login_at")
  notificationPreferences Json?     @map("notification_preferences")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  passwordChangedAt       DateTime? @map("password_changed_at")
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model SuperAdmin {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  lastLoginAt     DateTime?        @map("last_login_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  auditLogs       TenantAuditLog[]
  approvedTenants Tenant[]         @relation("TenantApprovedBy")

  @@map("super_admins")
}

model TenantAuditLog {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  adminId   String     @map("admin_id")
  action    String
  details   Json
  createdAt DateTime   @default(now()) @map("created_at")
  admin     SuperAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([adminId])
  @@index([createdAt])
  @@map("tenant_audit_logs")
}

model Role {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  name         String
  abbreviation String
  description  String?
  isDefault    Boolean          @default(false) @map("is_default")
  /// @deprecated - Legacy flag. Access to the administration module is now
  /// controlled via RolePermission rows for moduleKey "administration".
  /// This field will be removed in a future migration once all checks have
  /// been migrated to the module-based permission system.
  isAdmin      Boolean          @default(false) @map("is_admin")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  employees    Employee[]
  permissions  RolePermission[]
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@unique([tenantId, abbreviation])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id        String  @id @default(uuid())
  roleId    String  @map("role_id")
  moduleKey String  @map("module_key")
  canRead   Boolean @default(true) @map("can_read")
  canCreate Boolean @default(false) @map("can_create")
  canUpdate Boolean @default(false) @map("can_update")
  canDelete Boolean @default(false) @map("can_delete")
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
  @@index([roleId])
  @@map("role_permissions")
}

model Employee {
  id                      String              @id @default(uuid())
  tenantId                String              @map("tenant_id")
  roleId                  String              @map("role_id")
  firstName               String              @map("first_name")
  lastName                String              @map("last_name")
  email                   String              @unique
  passwordHash            String              @map("password_hash")
  phone                   String?
  jobTitle                String?             @map("job_title")
  avatarUrl               String?             @map("avatar_url")
  isActive                Boolean             @default(true) @map("is_active")
  mustChangePassword      Boolean             @default(true) @map("must_change_password")
  tokenVersion            Int                 @default(0) @map("token_version")
  lastLoginAt             DateTime?           @map("last_login_at")
  notificationPreferences Json?               @map("notification_preferences")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  passwordChangedAt       DateTime?           @map("password_changed_at")
  role                    Role                @relation(fields: [roleId], references: [id])
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectAssignments      ProjectAssignment[]

  @@index([tenantId])
  @@index([roleId])
  @@map("employees")
}

model Module {
  id            String         @id @default(uuid())
  key           String         @unique
  displayName   String         @map("display_name")
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  moduleKey  String    @map("module_key")
  isEnabled  Boolean   @default(true) @map("is_enabled")
  enabledAt  DateTime  @default(now()) @map("enabled_at")
  disabledAt DateTime? @map("disabled_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  module     Module    @relation(fields: [moduleKey], references: [key])
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_modules")
}

model Subscription {
  id                 String               @id @default(uuid())
  tenantId           String               @unique @map("tenant_id")
  billingCycle       BillingCycle         @map("billing_cycle")
  status             SubscriptionStatus
  monthlyAmount      Decimal              @map("monthly_amount") @db.Decimal(15, 2)
  annualAmount       Decimal              @map("annual_amount") @db.Decimal(15, 2)
  trialEndsAt        DateTime?            @map("trial_ends_at")
  currentPeriodStart DateTime             @map("current_period_start")
  currentPeriodEnd   DateTime             @map("current_period_end")
  cancelledAt        DateTime?            @map("cancelled_at")
  cancellationReason String?              @map("cancellation_reason")
  pendingCycleChange BillingCycle?        @map("pending_cycle_change")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  transactions       PaymentTransaction[]
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model SubscriptionModule {
  id                 String                   @id @default(uuid())
  tenantId           String                   @map("tenant_id")
  moduleKey          String                   @map("module_key")
  status             SubscriptionModuleStatus @default(ACTIVE)
  addedAt            DateTime                 @default(now()) @map("added_at")
  scheduledRemovalAt DateTime?                @map("scheduled_removal_at")
  removedAt          DateTime?                @map("removed_at")
  monthlyPrice       Decimal                  @map("monthly_price") @db.Decimal(15, 2)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("subscription_modules")
}

model PaymentMethod {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  type         PaymentMethodType
  isDefault    Boolean              @default(true) @map("is_default")
  lastFour     String?              @map("last_four")
  cardBrand    String?              @map("card_brand")
  holderName   String?              @map("holder_name")
  expiryMonth  Int?                 @map("expiry_month")
  expiryYear   Int?                 @map("expiry_year")
  momoPhone    String?              @map("momo_phone")
  country      String?
  city         String?
  state        String?
  zipCode      String?              @map("zip_code")
  isVerified   Boolean              @default(false) @map("is_verified")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([tenantId])
  @@map("payment_methods")
}

model PaymentTransaction {
  id              String                   @id @default(uuid())
  tenantId        String                   @map("tenant_id")
  subscriptionId  String                   @map("subscription_id")
  paymentMethodId String?                  @map("payment_method_id")
  amount          Decimal                  @db.Decimal(15, 2)
  currency        String                   @default("XAF")
  status          PaymentTransactionStatus
  type            PaymentTransactionType
  description     String?
  reference       String?
  failureReason   String?                  @map("failure_reason")
  paidAt          DateTime?                @map("paid_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  paymentMethod   PaymentMethod?           @relation(fields: [paymentMethodId], references: [id])
  subscription    Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([paymentMethodId])
  @@map("payment_transactions")
}

model InventoryItem {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  sku              String
  name             String
  description      String?
  category         String?
  quantity         Int                 @default(0) @map("qty")
  unitCost         Decimal             @map("unit_cost") @db.Decimal(15, 2)
  unit             String?
  lowStockAt       Int                 @default(5) @map("low_stock_at")
  status           InventoryStatus     @default(IN_STOCK)
  deprecated       Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements        InventoryMovement[]
  projectMaterials ProjectMaterial[]
  stockMovements   StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("inventory_items")
}

model ProductCategory {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  name           String
  normalizedName String              @map("normalized_name")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       InventoryCategory[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@map("product_categories")
}

model InventoryCategory {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  sku               String
  abbreviation      String
  name              String
  /// Unique per tenant when set, enforced by the PARTIAL unique index
  /// declared below: `(tenant_id, barcode) WHERE barcode IS NOT NULL`.
  ///
  /// It must stay partial. A plain `@@unique([tenantId, barcode])` would be
  /// wrong here in intent — it reads as "one product per barcode" but would
  /// also start constraining the many products that have no barcode at all.
  /// The filter keeps the rule where it belongs: on products that actually
  /// carry a barcode.
  ///
  /// The separate non-unique `@@index([tenantId, barcode])` below is kept for
  /// query performance and is not the constraint.
  barcode           String?
  productCategoryId String?            @map("product_category_id")
  /// How this product's stock is counted. SERIALIZED counts ProductItem rows
  /// (the Installation model); QUANTITY reads quantityOnHand directly.
  stockTrackingMode StockTrackingMode  @default(SERIALIZED) @map("stock_tracking_mode")
  /// Whether each physical unit carries its own barcode (a phone's IMEI) or every
  /// unit shares one product barcode (most solar panels). Null means nobody has
  /// said yet — receiving stock asks once, then remembers.
  hasUniquePerUnitBarcode Boolean?     @map("has_unique_per_unit_barcode")

  /// Which sales channels this product may be sold through.
  ///
  /// Two independent booleans rather than one exclusive `type`, because a product
  /// is often sold both ways from the *same* stock — rice by the bag at retail and
  /// by the pallet wholesale. Splitting it into separate per-channel product rows
  /// would recreate the two-disconnected-stock-numbers problem already fixed by
  /// getAvailableStock(). At least one must be true.
  retailEnabled    Boolean @default(true) @map("retail_enabled")
  wholesaleEnabled Boolean @default(true) @map("wholesale_enabled")
  /// Live on-hand count for QUANTITY products. Distinct from plannedQty, which
  /// keeps its original meaning: the purchase quantity authorised on an invoice.
  quantityOnHand    Int                @default(0) @map("quantity_on_hand")
  description       String?
  supplier          String?
  unit              String?
  costPrice         Decimal            @default(0) @map("cost_price") @db.Decimal(15, 2)
  sellingPrice      Decimal?           @map("selling_price") @db.Decimal(15, 2)
  plannedQty        Int                @default(0) @map("planned_qty")
  plannedDate       DateTime?          @map("planned_date")
  invoiceApproved   Boolean            @default(false) @map("invoice_approved")
  approvedInvoiceId String?            @map("approved_invoice_id")
  reorderThreshold  Int                @default(0) @map("reorder_threshold")
  type              ProductType        @default(STOCK)
  identifierType    IdentifierType?    @map("identifier_type")
  identifierLabel   String?            @map("identifier_label")
  imageUrl          String?            @map("image_url")
  images            Json               @default("[]") @map("images")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockLogs         CategoryStockLog[]
  customerPurchases CustomerPurchase[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory?   @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  invoices          Invoice[]
  productItems      ProductItem[]
  projectMaterials  ProjectMaterial[]  @relation("CategoryProjectMaterials")
  saleItems         SaleItem[]
  priceRules        PriceRule[]
  /// Phase 1 of product variants (2026-09). Empty for every product that has
  /// none — variantId stays null everywhere downstream and existing data is
  /// untouched. Variants apply only to InventoryCategory, never InventoryItem.
  variants          ProductVariant[]

  @@unique([tenantId, sku])
  /// Matches the live index `inventory_categories_tenant_id_barcode_key`.
  @@unique([tenantId, barcode], where: raw("barcode IS NOT NULL"))
  @@index([tenantId])
  @@index([tenantId, productCategoryId])
  @@index([tenantId, barcode])
  @@map("inventory_categories")
}

/// Phase 1 of product variants (2026-09, design-review approved). A variant
/// is one buyable option of a product — "Red / L / Glitter" — never its own
/// InventoryCategory row. Deliberately applies only to InventoryCategory,
/// never to the legacy InventoryItem model.
///
/// Attribute option axes (size, color, texture, ...) are defined per product
/// rather than normalized into their own tables: `attributes` is a Json map
/// of axis -> value on purpose, not a placeholder for a future normalized
/// design — different product categories have completely different axes and
/// there is no shared vocabulary worth enforcing across tenants.
model ProductVariant {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  category   InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String            @map("category_id")

  /// Option values that define this variant, e.g. {"size":"L","color":"Red","texture":"Glitter"}.
  ///
  /// This is jsonb, which SORTS object keys (by length, then bytewise) — the
  /// order the client submitted them in is gone by the time it is read back.
  /// That is why `axisOrder` below exists: the display order cannot be
  /// recovered from this column, only the values.
  attributes Json   @default("{}")
  /// The axis names in the order the label is built from, e.g.
  /// ["Color","Size","Texture"]. Captured from the submitting client's key
  /// order on the first variant of a product, then reused by every later
  /// variant of that product so labels stay consistent ("Red / L", "Blue / M"
  /// — never "M / Blue"). Kept as its own column precisely because
  /// `attributes` cannot preserve it.
  axisOrder  String[] @default([]) @map("axis_order")
  /// Flattened display string built from `attributes` in a stable, per-product
  /// axis order at write time, e.g. "Red / L / Glitter" — so receipts, stock
  /// logs and pickers never have to re-derive axis ordering from raw JSON.
  label      String

  /// Parent product's sku plus a suffix, e.g. "SHOE-001-RED-L". Optional:
  /// generating a matrix of a dozen combinations at once cannot invent a
  /// dozen meaningful codes, so generated variants start without one and it
  /// is filled in per variant afterwards. Unique per tenant WHEN SET, via the
  /// partial index below — same shape as barcode, so any number of variants
  /// may have no sku at all.
  sku        String?

  /// Optional, own barcode distinct from the parent product's — set only
  /// when a variant is physically labelled with its own code. Unique per
  /// tenant when set, via the PARTIAL unique index declared below — same
  /// shape as InventoryCategory.barcode, and declared here rather than in
  /// migration SQL because the `partialIndexes` preview feature is enabled
  /// (see the generator block): an undeclared partial index would be
  /// DROPPED by the next migration.
  barcode    String?

  /// Null = inherit the parent product's sellingPrice. Set = this variant's
  /// own flat price — itself still outranked by a matching PriceRule tier;
  /// see the 6-tier cascade in priceResolutionService.ts.
  priceOverride Decimal? @map("price_override") @db.Decimal(15, 2)

  /// Meaningful only when the parent category's stockTrackingMode is
  /// QUANTITY. For SERIALIZED products a variant carries no quantity column
  /// at all: its stock is the count of AVAILABLE ProductItem rows pointing
  /// at it, read through getAvailableStock (lib/stock.ts) — the same
  /// division of responsibility the parent category already follows.
  quantityOnHand Int @default(0) @map("quantity_on_hand")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  imageUrl  String? @map("image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productItems    ProductItem[]
  priceRules      PriceRule[]
  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]
  stockLogs       CategoryStockLog[]

  @@unique([tenantId, sku], where: raw("sku IS NOT NULL"))
  @@unique([tenantId, barcode], where: raw("barcode IS NOT NULL"))
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, categoryId, isActive])
  @@index([tenantId, barcode])
  @@map("product_variants")
}

model ProductItem {
  id                String                      @id @default(uuid())
  tenantId          String                      @map("tenant_id")
  categoryId        String                      @map("category_id")
  /// Was globally @unique; rescoped to unique-per-tenant as part of phase 1
  /// of product variants (2026-09). The format ({ABBR}-{YYYYMMDD}-{seq}) is a
  /// per-tenant human-readable document number, and two tenants can pick the
  /// same category abbreviation independently — under the old global
  /// constraint the second tenant's first unit of the day collided.
  ///
  /// ANY `findUnique({ where: { systemId } })` must become
  /// `findUnique({ where: { tenantId_systemId: { tenantId, systemId } } })`
  /// or `findFirst({ where: { systemId, tenantId } })`. At the time of this
  /// change there were none in the codebase.
  systemId          String                      @map("system_id")
  name              String?
  userIdentifier    String?                     @map("user_identifier")
  stockStatus       StockItemStatus?            @map("stock_status")
  inventoryStatus   InventoryItemStatus?        @map("inventory_status")
  notes             String?
  projectId         String?                     @map("project_id")
  projectMaterialId String?                     @map("project_material_id")
  addedAfterInvoice Boolean                     @default(false) @map("added_after_invoice")
  /// Null = this product has no variants (untouched existing data) or this
  /// unit predates variants being enabled for its product. For SERIALIZED
  /// products, a variant's on-hand stock is the count of AVAILABLE
  /// ProductItem rows with this variantId — see getAvailableStock in
  /// lib/stock.ts, the single source of truth for stock reads.
  variantId         String?                     @map("variant_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  maintenanceLogs   ProductItemMaintenanceLog[]
  category          InventoryCategory           @relation(fields: [categoryId], references: [id])
  variant           ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: Restrict)
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]

  @@unique([tenantId, systemId])
  @@index([tenantId, categoryId])
  @@index([tenantId, categoryId, stockStatus])
  @@index([tenantId, categoryId, inventoryStatus])
  @@index([tenantId, categoryId, variantId, stockStatus])
  @@index([tenantId, categoryId, variantId, inventoryStatus])
  @@index([tenantId, projectId])
  @@map("product_items")
}

