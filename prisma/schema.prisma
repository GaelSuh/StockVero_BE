/// One-time codes used to prove an owner actually controls the email address
/// they gave at signup, before the account is created.
model EmailVerificationOtp {
  id        String    @id @default(uuid())
  email     String    @map("email")
  otpHash   String    @map("otp_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// Wrong guesses against this code. Capped so a 6-digit code cannot be
  /// brute-forced inside its 15-minute window; the caller is told how many
  /// tries remain rather than being cut off without explanation.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_otps")
}

