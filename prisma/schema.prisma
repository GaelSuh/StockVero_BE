  OTHER
}

enum NotificationUserType {
  OWNER
  EMPLOYEE
}

enum PasswordResetUserType {
  OWNER
  EMPLOYEE
}

enum DocumentModule {
  PROJECT
  INVENTORY
  FINANCE
  CUSTOMER
  PRODUCT_ITEM
}

enum AuditActorType {
  OWNER
  EMPLOYEE
  SYSTEM
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

// ─── POS: Retail & Wholesale Module Enums ───

/// What kind of business this is. Chosen at signup and changeable in Settings.
/// Drives which modules are suggested — never which are allowed, since a shop
/// can always tick something the default did not.
enum OrganizationType {
  RETAIL_SHOP
  WHOLESALE_DISTRIBUTION
  /// Sells both ways from the same stock — a shop that also supplies kiosks.
  RETAIL_WHOLESALE
  MANUFACTURING
  SERVICE_INSTALLATION
  /// Deliberate escape hatch: better an honest "other" than forcing a wrong fit.
  OTHER
}

enum SaleMode {
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIAL
  CANCELLED
  RETURNED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  CREDIT
  REFUNDED
}

enum SalePaymentMethod {
  CASH
  MTN_MOMO
  ORANGE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  PARTIAL_DELIVERY
}

// ─── POS: Retail & Wholesale Module Models ───

model Sale {
  id         String     @id @default(uuid())
  tenantId   String     @map("tenant_id")
  saleNumber String     @map("sale_number")
  mode       SaleMode
  status     SaleStatus @default(COMPLETED)

  customerId String? @map("customer_id")
  customerName String? @map("customer_name")

  soldById   String               @map("sold_by_id")
  soldByType NotificationUserType @map("sold_by_type")
  soldByName String               @map("sold_by_name")

  subtotal       Decimal       @db.Decimal(15, 2)
  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(15, 2)

  paymentStatus SalePaymentStatus @default(PAID) @map("payment_status")
  amountPaid    Decimal           @map("amount_paid") @db.Decimal(15, 2)
  amountOwed    Decimal           @default(0) @map("amount_owed") @db.Decimal(15, 2)
  /// Money tendered beyond the sale total (e.g. cash paid over the amount due).
  /// Never left owed to the customer as change or credit — attributed to
  /// `soldById` as a tip and recorded as its own income transaction.
  tipAmount     Decimal           @default(0) @map("tip_amount") @db.Decimal(15, 2)
  creditDueDate DateTime?         @map("credit_due_date")

  deliveryStatus  DeliveryStatus? @map("delivery_status")
  deliveryNotes   String?         @map("delivery_notes_text")
  minimumOrderMet Boolean?        @map("minimum_order_met")

  /// What the customer left as security against a credit sale, if anything.
  /// Free text — a shop takes an ID card, a phone, a tool; there is no useful
  /// enum for it. Kept separate from `notes` so it can actually be looked up.
  creditCollateral String? @map("credit_collateral")

  offlineId      String?   @unique @map("offline_id")
  createdOffline Boolean   @default(false) @map("created_offline")
  syncedAt       DateTime? @map("synced_at")

  transactionId String? @unique @map("transaction_id")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?      @relation(fields: [customerId], references: [id])
  transaction       Transaction?   @relation(fields: [transactionId], references: [id])
  items             SaleItem[]
  payments          SalePayment[]
  returns           SaleReturn[]
  saleDeliveryNotes DeliveryNote[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, mode])
  @@index([tenantId, paymentStatus])
  @@map("sales")
}

model SaleItem {
  id         String @id @default(uuid())
  saleId     String @map("sale_id")
  categoryId String @map("category_id")

  productName String  @map("product_name")
  sku         String?
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  quantity    Int

  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal?      @map("discount_value") @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)

  lineTotal Decimal @map("line_total") @db.Decimal(15, 2)

  batchNumber String? @map("batch_number")
  lotNumber   String? @map("lot_number")

  /// The specific serialized unit sold on this line, if the product is
  /// SERIALIZED. Null for QUANTITY-tracked lines, which have no single unit.
  productItemId String? @map("product_item_id")
  /// Denormalized copy of the unit's identifier at sale time, so the receipt
  /// still shows it even if the ProductItem is later edited or removed.
  serialNumber   String? @map("serial_number")

  /// Null when the product has no variants. Resolved and snapshotted
  /// server-side in sales.controller.ts from the ProductVariant row, not
  /// trusted verbatim from the client — same reasoning as the retail price
  /// fix: a sale line is not a place to trust unverified client input about
  /// what was actually sold.
  variantId    String? @map("variant_id")
  /// Denormalized copy of ProductVariant.label at sale time, following the
  /// exact precedent set by serialNumber above — survives later edits to or
  /// deletion of the source variant.
  variantLabel String? @map("variant_label")

  createdAt DateTime @default(now()) @map("created_at")

  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  category    InventoryCategory @relation(fields: [categoryId], references: [id])
  productItem ProductItem?      @relation(fields: [productItemId], references: [id])
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([categoryId])
  @@index([productItemId])
  @@index([variantId])
  @@map("sale_items")
}

model SalePayment {
  id        String            @id @default(uuid())
  saleId    String            @map("sale_id")
  method    SalePaymentMethod
  amount    Decimal           @db.Decimal(15, 2)
  reference String?

  paidAt         DateTime @default(now()) @map("paid_at")
  recordedById   String   @map("recorded_by_id")
  recordedByName String   @map("recorded_by_name")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model SaleReturn {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  saleId       String @map("sale_id")
  returnNumber String @map("return_number")

  reason     String
  returnType ReturnType @map("return_type")

  refundAmount Decimal            @map("refund_amount") @db.Decimal(15, 2)
  refundMethod SalePaymentMethod? @map("refund_method")

  processedById   String @map("processed_by_id")
  processedByName String @map("processed_by_name")

  /// For an EXCHANGE: the sale raised for the replacement goods going out.
  /// The replacement flows through the normal sale path so it deducts stock,
  /// records income and appears in reports like any other sale; this is the
  /// thread back to the return that caused it.
  exchangeSaleId String? @map("exchange_sale_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale             @relation(fields: [saleId], references: [id])
  items  SaleReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id          String  @id @default(uuid())
  returnId    String  @map("return_id")
  categoryId  String  @map("category_id")
  productName String  @map("product_name")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  /// Which variant is coming back. Without this, a return on a variant
  /// product can't say which option it is — meaning a return would restock
  /// the wrong option once variants exist. Correctness fix, not optional.
  variantId   String? @map("variant_id")

  saleReturn SaleReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([variantId])
  @@map("sale_return_items")
}

model PriceList {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules     PriceRule[]
  customers CustomerPriceList[]

  /// At most one default price list per tenant. Partial on `is_default`, so
  /// any number of non-default lists coexist. priceResolutionService reads
  /// this with findFirst({ tenantId, isDefault: true }) and would silently
  /// pick an arbitrary winner if two ever existed.
  @@unique([tenantId], where: raw("is_default"), map: "price_lists_one_default_per_tenant")
  @@index([tenantId])
  @@map("price_lists")
}

model PriceRule {
  id          String  @id @default(uuid())
  priceListId String  @map("price_list_id")
  categoryId  String  @map("category_id")
  /// Null = applies to every variant of the product (and to products with no
  /// variants at all) — this is what every pre-phase-1 rule has and keeps.
  /// Set = applies only to this one variant, and outranks a null-variant
  /// rule at the same minQuantity tier. See the 6-tier cascade in
  /// priceResolutionService.ts.
  variantId   String? @map("variant_id")
  minQuantity Int     @default(1) @map("min_quantity")
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)

  priceList PriceList         @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  category  InventoryCategory @relation(fields: [categoryId], references: [id])
  variant   ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Two partial unique indexes, not one NULLS NOT DISTINCT constraint —
  /// confirmed empirically that Prisma 7.8's diffing never sees NULLS NOT
  /// DISTINCT (matches on name+columns only, blind to the clause itself),
  /// making it a permanent, not just next-migration, drop hazard. These two
  /// are fully visible to partialIndexes diffing instead: one product-level
  /// rule per tier, one rule per variant per tier.
  @@unique([priceListId, categoryId, minQuantity], where: raw("variant_id IS NULL"), map: "price_rules_product_tier_key")
  @@unique([priceListId, categoryId, variantId, minQuantity], where: raw("variant_id IS NOT NULL"), map: "price_rules_variant_tier_key")
  @@index([priceListId])
  @@index([categoryId])
  @@index([priceListId, categoryId, variantId])
  @@map("price_rules")
}

model CustomerPriceList {
  id          String @id @default(uuid())
  customerId  String @map("customer_id")
  priceListId String @map("price_list_id")

  /// When this customer was put on this price list. The assignment list shows
  /// it, and without the column every row rendered "Invalid Date" — the UI was
  /// reading a field that had never existed.
  createdAt DateTime @default(now()) @map("created_at")

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([customerId, priceListId])
  @@index([customerId])
  @@index([priceListId])
  @@map("customer_price_lists")
}

model DeliveryNote {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  saleId     String         @map("sale_id")
  noteNumber String         @map("note_number")
  status     DeliveryStatus @default(PENDING)

  dispatchedAt DateTime? @map("dispatched_at")
  deliveredAt  DateTime? @map("delivered_at")

  driverName  String? @map("driver_name")
  vehicleInfo String? @map("vehicle_info")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale               @relation(fields: [saleId], references: [id])
  items  DeliveryNoteItem[]

  @@unique([tenantId, noteNumber])
  @@index([tenantId])
  @@index([saleId])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id               String @id @default(uuid())
  deliveryNoteId   String @map("delivery_note_id")
  saleItemId       String @map("sale_item_id")
  quantityShipped  Int    @map("quantity_shipped")
  quantityReceived Int?   @map("quantity_received")

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_note_items")
}

model DailySummary {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  date     DateTime @db.Date

  totalSales           Int     @default(0) @map("total_sales")
  totalRevenue         Decimal @default(0) @map("total_revenue") @db.Decimal(15, 2)
  cashCollected        Decimal @default(0) @map("cash_collected") @db.Decimal(15, 2)
  mobileMoneyCollected Decimal @default(0) @map("mobile_money_collected") @db.Decimal(15, 2)
  cardCollected        Decimal @default(0) @map("card_collected") @db.Decimal(15, 2)
  creditGiven          Decimal @default(0) @map("credit_given") @db.Decimal(15, 2)
  returnsTotal         Decimal @default(0) @map("returns_total") @db.Decimal(15, 2)

  generatedAt DateTime @default(now()) @map("generated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("daily_summaries")
}

model SaleSequence {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  lastSeq  Int    @default(0) @map("last_seq")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sale_sequences")
}
